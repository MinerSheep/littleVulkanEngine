# Somebody camped here. The key is on the ground beside the tent
room Tent_Camp
  size 18 13
  height 4
  open
  light -4.0 -3.0  1.0   0.34 0.40 0.46   15
  light  5.0 -3.0 -1.0   0.24 0.32 0.42   15
  door south  south   3
  door east   east   -4
  door north  north  -6
  prop tree  5.400 0.500 4.600   0.000 1.100 0.000   0.420 0.420 0.420
  prop tree2 7.000 0.500 3.800   0.000 3.300 0.000   0.380 0.380 0.380
  prop tree  -7.400 0.500 -3.600   0.000 0.800 0.000   0.360 0.360 0.360
  interact cube  -1.000 -0.100 0.600   0.000 0.300 0.000   1.400 1.000 1.300  name tent
    do say A TENT, STILL PEGGED OUT AND STILL DRY INSIDE.
    do say WHOEVER PUT IT UP MEANT TO COME BACK.
  interact cube  -3.509 0.440 -4.116   0.000 0.850 0.000   0.220 0.060 0.090  name key
    when noitem key
    do say A KEY, LYING WHERE IT WAS DROPPED.
    do sound stone
    do hide self
    do flag took_key
    do give key 1
    when item key
    do say THE GRASS IS STILL FLAT WHERE IT WAS.
  prop tree2 -7.954 0.500 -0.799   0.000 0.000 0.000   0.353 0.353 0.353
  prop tree  -8.146 0.500 2.546   0.000 0.000 0.000   0.357 0.357 0.357
  prop tree  -2.607 0.500 6.219   0.000 0.000 0.000   0.358 0.358 0.358
  prop tree  -0.001 0.500 5.454   0.000 0.000 0.000   0.369 0.369 0.369
  prop tree  2.671 0.500 5.377   0.000 0.000 0.000   0.362 0.362 0.362
  prop tree  -0.718 0.500 -6.293   0.000 0.000 0.000   0.398 0.398 0.398




