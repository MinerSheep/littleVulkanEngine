# Area two: the forest, and the house at the end of it
#
# The door out of building two comes up on trees. Nothing says so -- the rooms
# down here have no names in the corner, which is what 'hidenames' does. The
# house is the one thing in the forest that admits what it is.
#
# Compile it with:
#   python3 tools/build_map.py maps/forest.mapsrc -o maps/forest.map
#
# Laid out from maps/forest_two_layout.png. Everything outdoors is 'open', so
# only the frame around each doorway stands -- you can see clearing to clearing
# and still not be able to walk it.

map forest
start Start
hidenames


# Where you come to. One way on and no way back
room Start
  size 8 12
  height 4
  open
  light 0.0 -2.8 -2.0   0.30 0.38 0.48   12
  light 0.0 -2.8  3.0   0.26 0.34 0.44   12
  door on north 0
  prop tree  -3.0 0.5 -4.2   0 0.4 0   0.35 0.35 0.35
  prop tree2  3.2 0.5  4.0   0 2.1 0   0.30 0.30 0.30
  prop rock   2.6 0.17 -3.4  0 0.9 0   0.45 0.45 0.45


# A stand of trees with a way out either side
room Clearing_Trees
  size 14 10
  height 4
  open
  light -3.0 -2.8 0.0   0.30 0.38 0.48   13
  light  4.0 -2.8 1.0   0.24 0.32 0.42   13
  door back  south  1.5
  door west  west   0
  door east  east   1.5
  prop tree  -1.5 0.5  1.5   0 0.7 0   0.45 0.45 0.45
  prop tree   0.5 0.5  2.6   0 2.8 0   0.40 0.40 0.40
  prop tree  -2.8 0.5  3.0   0 1.5 0   0.38 0.38 0.38
  prop tree   1.8 0.5  0.4   0 0.2 0   0.34 0.34 0.34
  prop rock  -4.5 0.17 -2.0  0 1.8 0   0.55 0.55 0.55


