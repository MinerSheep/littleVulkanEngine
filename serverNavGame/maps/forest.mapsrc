# A ring of mushrooms, and a wall with nothing on the other side of it
room Ring
  size 14 15
  height 4
  open
  light -3.0 -3.0  0.0   0.30 0.34 0.40   14
  light  3.0 -3.0  0.0   0.22 0.26 0.34   14
  door north  north  -3
  door west   west   -3

  # The wall closes the east side off and goes nowhere either way along it
  prop cube  6.2 -1.20 0.0   0 0 0   0.35 1.75 7.20   name wall

  prop cylinder  -2.00 0.44  0.00   0 0 0   0.18 0.10 0.18
  prop cylinder  -1.24 0.44  1.57   0 0 0   0.18 0.10 0.18
  prop cylinder   0.62 0.44  1.90   0 0 0   0.18 0.10 0.18
  prop cylinder   1.80 0.44  0.87   0 0 0   0.18 0.10 0.18
  prop cylinder   1.80 0.44 -0.87   0 0 0   0.18 0.10 0.18
  prop cylinder   0.62 0.44 -1.90   0 0 0   0.18 0.10 0.18
  prop cylinder  -1.24 0.44 -1.57   0 0 0   0.18 0.10 0.18

  interact cylinder  0.00 0.44 0.00   0 0 0   0.18 0.10 0.18   name mushrooms
    do say MUSHROOMS, GROWN IN A RING.
    do say THE ONE IN THE MIDDLE IS THE ONE THAT SHOULD NOT BE THERE.

  # F05: pressing E does nothing you can see, and it starts walking after you
  interact tree  -4.80 0.50 4.20   0 0.9 0   0.34 0.34 0.34   name walker
    do say IT IS A TREE.
    do flag tree_walks


