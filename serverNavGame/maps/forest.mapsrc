# A well nobody has drawn from, on the way between the gate and the car
room Well_Path
  size 6 16
  height 4
  open
  light 0.0 -2.8 -4.0   0.30 0.38 0.48   13
  light 0.0 -2.8  4.0   0.24 0.32 0.42   13
  door south  south  0
  door east   east   5
  door west   west   5
  prop tree2 -1.9 0.5  7.0   0 0.6 0   0.30 0.30 0.30
  prop tree2  1.7 0.5  7.2   0 2.9 0   0.28 0.28 0.28

  interact cylinder  -1.6 0.10 0.0   0 0 0   0.85 0.55 0.85   name well
    do say A WELL, WITH THE LID STILL ON IT.
    do sound stone
    do say IT HAS NOT BEEN OPENED IN A LONG TIME.


# A gate standing on its own, with nothing either side of it
room Gate_Clearing
  size 16 6
  height 4
  open
  light -4.0 -2.8 0.0   0.28 0.36 0.46   13
  light  4.0 -2.8 0.0   0.24 0.32 0.42   13
  door east   east    1
  door north  north  -5
  prop tree  -6.400 0.500 -1.400   0.000 1.300 0.000   0.360 0.360 0.360
  prop tree2  -4.932 0.500 -2.100   0.000 3.400 0.000   0.320 0.320 0.320
  interact gate  -0.072 0.600 1.594  0.000 3.142 0.000  0.224 0.248 1.990  name gate
    when noflag gate_opened
    do say A GATE, AND NO FENCE ON EITHER SIDE OF IT.|IT WILL NOT MOVE WITHOUT A KEY.
    do take key 1
    do say THE KEY FROM THE TENT TURNS IN IT.
    do flag gate_opened
    when flag gate_opened
    do sound lever
    do move gate  -0.072 0.231 4.126 over 1.100 toggle
    do rotate gate  0.000 87.026 0.000 over 0.600 toggle
    do say IT SWINGS. NOTHING ABOUT THE WALK CHANGES.
  prop cube  -0.177 -0.805 -1.804   0.000 0.000 0.000   1.316 1.316 1.316



# Somebody drove in here, which cannot be done
room Car_Clearing
  size 15 10
  height 4
  open
  light -4.0 -2.8 1.0   0.30 0.38 0.48   13
  light  4.0 -2.8 0.0   0.24 0.32 0.42   13
  door west   west   2
  door south  south  4
  prop tree  -5.4 0.5 -3.6   0 0.9 0   0.34 0.34 0.34
  prop tree2 -2.2 0.5  3.9   0 2.6 0   0.30 0.30 0.30
  prop tree   6.4 0.5 -3.4   0 4.1 0   0.30 0.30 0.30

  interact cube  2.6 0.05 1.6   0 0.42 0   1.90 0.62 0.90   name car
    when noflag saw_car
    do say A CAR, WITH THE DOORS SHUT AND THE GLASS STILL IN IT.
    do say THERE IS NO ROAD.
    do flag saw_car
    when flag saw_car
    do say THERE IS STILL NO ROAD.


