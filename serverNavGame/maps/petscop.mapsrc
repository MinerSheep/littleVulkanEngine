# The map: rooms, and the doors between them
#
# Rooms are boxes. Give a size and a height and the build tool fills in the floor
# and the walls, leaving a gap wherever there is a door.
#
# Remember -Y is up. The floor is at y = 0.5 and a room of height 3 reaches up to
# y = -2.5, so lights and cameras want negative y to be above the floor.
#
# Compile it with:
#   python3 tools/build_map.py maps/petscop.mapsrc -o maps/petscop.map
#
# Things you can stand in a room:
#   prop     <mesh>  tx ty tz  rx ry rz  sx sy sz  name <id>
#   interact <mesh>  tx ty tz  rx ry rz  sx sy sz  [name <id>]
#
# An interact is a prop you can press E on. What that does is the 'do' lines
# under it, which run top to bottom. A 'do say' waits for you to read it, the
# rest happen straight away:
#
#   do say    <words, | starts a new page>
#   do sound  <clip, from sounds/>
#   do move   <prop|self>  dx dy dz     over <seconds>  [toggle]
#   do rotate <prop|self>  rx ry rz     over <seconds>  [toggle]
#   do scale  <prop|self>  fx fy fz     over <seconds>  [toggle]
#   do show   <prop|self>
#   do hide   <prop|self>
#   do give   <item> [count]     put an item in your pocket
#   do take   <item> [count]     take one back out
#   do flag   <name>             remember that something happened
#   do unflag <name>
#
# Items and flags live in saves/petscop.save and outlast the run. A 'when' line
# gates every 'do' under it, up to the next 'when' or the next prop:
#
#   when flag <name>     when noflag <name>
#   when item <name>     when noitem <name>
#   when always          back to ungated
#
#   interact cube  0 0 0  0 0 0  1 1 1  name chest
#     when noflag chest_open
#     do say THE LID GIVES.
#     do give red_key
#     do flag chest_open
#     when flag chest_open
#     do say IT IS EMPTY NOW.
#
# A prop whose lines are all gated off draws no floating E.
#
# The prop being acted on does NOT have to be the one you pressed E on -- name
# something with 'name' and any action in the same room can point at it.
#
# Watch the units. Placement rx ry rz is in RADIANS, matching what the editor
# saves, but 'do rotate' is in DEGREES because nobody wants to type 1.5708 for a
# quarter turn. 'do scale' is a multiplier off the size the prop was built at.
#
# 'toggle' means the next press puts it back exactly where the map stood it.
# Without it each press goes a further step in the same direction.
#
# Two things change what a room's walls look like:
#
#   open              outdoors -- keeps the frame around each doorway and nothing else
#   wallheight <h>    walls shorter than the room, like a terrace you see over

map petscop
start Foyer


# The room you wake up in. Wide and short, one way on and a side room
room Foyer
  size 12 8
  height 3
  light  0.0 -2.2  0.0   1.00 0.95 0.85   9
  light -4.0 -1.6  2.0   0.35 0.45 0.80   5
  door hallway  north   0
  door closet   east   -1.5
  props rooms/foyer_props.layout
  interact tree  -3.0 0.5 2.0  0 0 0  0.30 0.30 0.30  name tree  say THE TREE IS TALLER THAN THE ROOM SHOULD ALLOW.|NOBODY REMEMBERS PLANTING IT.

  # Bare floor under the tree. Kept hidden until the tree goes
  interact cube  -3.000 0.470 2.000   0 0 0   0.900 0.030 0.900  name tree_hole  say SOMEBODY TOOK IT.

  # A slab dropped across the closet doorway, and the lever on the far side of
  # the room that lifts it. Pressing E on the lever moves something you are not
  # standing next to, which is the whole point of naming things
  prop cube  5.300 -0.650 -1.500   0 0 0   0.250 1.150 0.900  name gate

  interact cube  1.400 0.100 -1.500   0 0 0   0.150 0.400 0.150  name lever
    do say A LEVER, SET INTO THE FLOOR.|IT HAS BEEN PULLED BEFORE.
    do sound lever
    do rotate self  -32 0 0  over 0.25  toggle
    do move gate  0 -2.600 0  over 1.10  toggle
    do say SOMETHING SHIFTS BY THE EAST WALL.


# A long corridor running away from the foyer, up to the main hall
room Hall
  size 6 14
  height 3
  light 0.0 -2.4 -4.0   1.00 0.90 0.75   8
  light 0.0 -2.4  4.0   0.80 0.85 1.00   8
  door back    south   0
  door deeper  north   0


# A dead end off the side of the foyer, low ceiling
room Closet
  size 6 6
  height 2.6
  light 0.0 -1.8 0.0   1.00 0.60 0.30   7
  door out  west  0
  # No toggle on the turn, so every press moves it another quarter turn on
  interact rock  0.0 0.17 0.0  0 0.6 0  0.60 0.60 0.60  name rock
    do say A ROCK, WORN SMOOTH ON ONE SIDE.|SOMEONE HAS BEEN TURNING IT OVER.
    do sound stone
    do rotate rock  0 90 0  over 0.45

  # Pinned to the north wall. Read the other way round it says NW FIELD
  interact cube  0.000 -0.800 2.700   0 0 0   0.400 0.300 0.020   name note
    do say A NOTE, PINNED FLAT TO THE WALL.|DLEIF WN
    do flag read_note


# The wide corridor the whole building hangs off. Everything upstairs of the
# foyer is reached from here
room Hall_Main
  size 32 6
  height 3
  light -12.0 -2.4 0.0   1.00 0.90 0.75   9
  light   0.0 -2.4 0.0   0.95 0.90 0.80   9
  light  11.0 -2.4 0.0   0.80 0.85 1.00   9
  door west_hall  south  -12
  door lower      south    0
  door greenhouse north  -12
  door bathroom   north     0
  door billiard   north     8
  door ballroom   east      0


# The corridor down to the back door, and out into the yard
room Hall_West
  size 6 12
  height 3
  light 0.0 -2.4 -3.0   1.00 0.90 0.75   8
  light 0.0 -2.4  3.0   0.90 0.90 0.85   8
  door yard   south  0
  door inside north  0


# Outdoors. No walls, only the frame of the door you came out of, up in the
# far corner where the back of the house is
room Yard
  size 30 12
  height 3
  open
  light -8.0 -2.6  0.0   0.55 0.65 0.85   14
  light  8.0 -2.6  0.0   0.50 0.60 0.80   14
  door back north 11
  props rooms/yard_grass.layout pass

  prop tree  -11.000 0.500  2.500   0 0.400 0   0.400 0.400 0.400
  prop tree   -4.000 0.500 -3.000   0 2.100 0   0.330 0.330 0.330
  prop tree    5.500 0.500  1.000   0 1.200 0   0.360 0.360 0.360
  prop rock  -13.000 0.168 -4.000   0 0.900 0   0.600 0.600 0.600
  prop rock    2.000 0.279 -4.500   0 2.400 0   0.400 0.400 0.400

  # Two stones either side of a patch of turned earth. The spade is in the shed
  prop rock  -7.000 0.279 2.000   0 0.500 0   0.350 0.350 0.350
  prop rock  -5.000 0.279 2.000   0 1.900 0   0.350 0.350 0.350

  interact cube  -6.000 0.470 2.000   0 0 0   0.600 0.030 0.600   name dig_patch
    when noitem spade
    do say THE EARTH HERE HAS BEEN TURNED BEFORE.|NOT BY HAND.
    when item spade
    do say THE EARTH TURNS EASILY HERE.|SOMETHING IS UNDER IT.
    do sound stone
    do give piece
    do flag quest_dig
    do take spade


# A washroom off the main hall
room Bathroom
  size 8 6
  height 3
  light 0.0 -2.2 0.0   0.85 0.95 1.00   7
  door out south 0

  # Hung too high on the far wall. The cue from the billiard room is what reaches it
  interact cube  0.000 -1.550 2.700   0 0 0   0.900 0.650 0.030   name mirror
    when noitem cue
    do say A MIRROR, HUNG TOO HIGH TO SEE YOURSELF IN.|IT DOES NOT SIT FLAT.
    when item cue
    do say YOU LEVER THE CUE IN BEHIND THE MIRROR.|IT COMES OFF THE WALL.
    do sound stone
    do hide mirror
    do flag quest_mirror


# Long room off the north side of the hall
room Billiard_Room
  size 8 13
  height 3
  light 0.0 -2.3 -3.0   1.00 0.85 0.60   8
  light 0.0 -2.3  3.0   1.00 0.85 0.60   8
  door out south 0

  # The balls on the table are laid out by the game, not by this file
  prop cube  0.000 0.100 1.000   0 0 0   3.000 0.400 1.400   name table

  interact cylinder  -3.400 -0.400 4.000   0 0 0.250   0.080 1.200 0.080   name cue
    when noitem cue
    do say A CUE, STOOD AGAINST THE WALL.|IT IS LONGER THAN YOUR ARM.
    do give cue
    do flag took_cue
    when item cue
    do say THERE IS NOWHERE TO STAND IT BACK.


# The big room at the east end of the hall
room Ballroom
  size 14 12
  height 4
  light -4.0 -3.2  0.0   1.00 0.95 0.85   12
  light  4.0 -3.2  0.0   0.95 0.90 1.00   12
  door out west 0

  # Stood in the middle of an empty floor. It is not here the second time
  interact cube  0.000 -0.300 0.000   0 0.300 0   0.900 0.800 0.500   name piano
    do say A PIANO, IN THE MIDDLE OF THE FLOOR.|NOTHING IS ARRANGED AROUND IT.
    do sound piano


# Glass room between the hall and the field
room Greenhouse
  size 12 6
  height 3
  light -3.0 -2.4 0.0   0.75 1.00 0.80   8
  light  3.0 -2.4 0.0   0.75 1.00 0.80   8
  door inside south 0
  door field  north 0


# Outdoors, and the widest place on the map. The stairs on the east side climb
# to the terrace
room Field
  size 24 12
  height 3
  open
  light -7.0 -2.6 0.0   0.70 0.80 0.95   16
  light  7.0 -2.6 0.0   0.65 0.75 0.90   16
  door greenhouse south  0
  door shed       west   0
  door stairs     east   0
  props rooms/field_grass.layout pass

  prop tree  -7.000 0.500  3.000   0 0.700 0   0.450 0.450 0.450
  prop tree   6.500 0.500  3.500   0 2.800 0   0.420 0.420 0.420
  prop tree  -2.000 0.500  4.000   0 1.500 0   0.350 0.350 0.350
  prop tree   9.000 0.500 -3.500   0 0.200 0   0.300 0.300 0.300
  prop rock   3.000 0.113 -1.000   0 1.800 0   0.700 0.700 0.700
  prop rock  -4.500 0.223 -3.000   0 0.300 0   0.500 0.500 0.500


# A small outbuilding on the west edge of the field
room Shed
  size 7 7
  height 2.6
  light 0.0 -1.8 0.0   1.00 0.70 0.40   6
  door out east 0

  interact blade1  -3.000 -0.100 -1.000   0 0 0   0.500 0.500 0.500   name spade
    when noitem spade
    do say A SPADE, LEANING WHERE A TOOL SHOULD HANG.
    do give spade
    do flag took_spade
    when item spade
    do say THE HOOK IT CAME OFF IS EMPTY.

  # What the board says is written by the game out of your own save
  interact cube  0.000 -0.700 3.200   0 0 0   1.200 0.700 0.030   name board
    do say THE BOARD IS BLANK.


# The field again, with nothing standing in it. Deliberately has no doors --
# the game walks you back out of it once you have gone far enough in
room Field_Red
  size 24 12
  height 3
  open
  light -6.0 -2.0 0.0   0.70 0.06 0.06   16
  light  6.0 -2.0 0.0   0.60 0.05 0.05   16


# Walled only to the waist, so you can see the field from it
room Terrace
  size 8 6
  height 3
  wallheight 1.4
  light 0.0 -2.4 0.0   0.85 0.90 1.00   10
  door stairs west  0
  door doors  north 0


# The way into the second building. It goes no further yet
room Building_Two
  size 9 5
  height 3
  light 0.0 -2.2 0.0   0.90 0.85 0.95   7
  door outside south 0
  door inside  north 0


link Foyer.hallway  Hall.back
link Foyer.closet   Closet.out

link Hall.deeper          Hall_Main.lower
link Hall_Main.west_hall  Hall_West.inside
link Hall_West.yard       Yard.back
link Hall_Main.bathroom   Bathroom.out
link Hall_Main.billiard   Billiard_Room.out
link Hall_Main.ballroom   Ballroom.out
link Hall_Main.greenhouse Greenhouse.inside
link Greenhouse.field     Field.greenhouse
link Field.shed           Shed.out
link Field.stairs         Terrace.stairs
link Terrace.doors        Building_Two.outside
